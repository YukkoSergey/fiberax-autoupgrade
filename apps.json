{
 "_comment": "Профілі софту з маркетплейсу Fiberax для vm-guardian. Програма розпізнається на машині за ознаками з detect (будь-яка з них), а не за назвою образу. data - дані, під які доречно докуповувати диск; logs - логи, які треба ротувати; caches - теки, де можна видаляти файли, старші за max_age_days; backups - власні бекапи програми (лише показуються в листі); cleanup - штатні безпечні команди очищення; advice - підказка власнику, коли програма росте.",
 "apps": [
  {
   "id": "wordpress",
   "name": "WordPress / WooCommerce",
   "images": [
    "WordPress",
    "WooCommerce"
   ],
   "detect": {
    "paths": [
     "/var/www/html/wp-config.php",
     "/var/www/*/wp-config.php",
     "/var/www/*/public_html/wp-config.php",
     "/var/www/*/htdocs/wp-config.php",
     "/srv/www/*/wp-config.php",
     "/var/www/vhosts/*/httpdocs/wp-config.php",
     "/www/wwwroot/*/wp-config.php"
    ],
    "containers": [
     "(^|/)wordpress(:|$)"
    ]
   },
   "data": [
    "/var/www/html/wp-content/uploads",
    "/var/www/*/wp-content/uploads",
    "/var/www/*/public_html/wp-content/uploads",
    "/var/www/*/htdocs/wp-content/uploads",
    "/srv/www/*/wp-content/uploads",
    "/var/www/vhosts/*/httpdocs/wp-content/uploads",
    "/www/wwwroot/*/wp-content/uploads",
    "/var/lib/mysql"
   ],
   "logs": [
    "/var/www/html/wp-content/debug.log",
    "/var/www/*/wp-content/debug.log",
    "/var/www/*/public_html/wp-content/debug.log",
    "/var/www/*/htdocs/wp-content/debug.log",
    "/srv/www/*/wp-content/debug.log",
    "/var/www/vhosts/*/httpdocs/wp-content/debug.log",
    "/www/wwwroot/*/wp-content/debug.log",
    "/var/www/html/wp-content/uploads/wc-logs/*.log",
    "/var/www/*/wp-content/uploads/wc-logs/*.log",
    "/var/www/*/public_html/wp-content/uploads/wc-logs/*.log",
    "/var/www/*/htdocs/wp-content/uploads/wc-logs/*.log",
    "/srv/www/*/wp-content/uploads/wc-logs/*.log",
    "/var/www/vhosts/*/httpdocs/wp-content/uploads/wc-logs/*.log",
    "/www/wwwroot/*/wp-content/uploads/wc-logs/*.log"
   ],
   "caches": [
    {
     "path": "/var/www/html/wp-content/cache",
     "max_age_days": 7
    },
    {
     "path": "/var/www/*/wp-content/cache",
     "max_age_days": 7
    },
    {
     "path": "/var/www/*/public_html/wp-content/cache",
     "max_age_days": 7
    },
    {
     "path": "/var/www/*/htdocs/wp-content/cache",
     "max_age_days": 7
    },
    {
     "path": "/srv/www/*/wp-content/cache",
     "max_age_days": 7
    },
    {
     "path": "/var/www/vhosts/*/httpdocs/wp-content/cache",
     "max_age_days": 7
    },
    {
     "path": "/www/wwwroot/*/wp-content/cache",
     "max_age_days": 7
    },
    {
     "path": "/var/www/html/wp-content/upgrade",
     "max_age_days": 7
    },
    {
     "path": "/var/www/*/wp-content/upgrade",
     "max_age_days": 7
    },
    {
     "path": "/var/www/*/public_html/wp-content/upgrade",
     "max_age_days": 7
    },
    {
     "path": "/var/www/*/htdocs/wp-content/upgrade",
     "max_age_days": 7
    },
    {
     "path": "/srv/www/*/wp-content/upgrade",
     "max_age_days": 7
    },
    {
     "path": "/var/www/vhosts/*/httpdocs/wp-content/upgrade",
     "max_age_days": 7
    },
    {
     "path": "/www/wwwroot/*/wp-content/upgrade",
     "max_age_days": 7
    },
    {
     "path": "/var/www/html/wp-content/uploads/wc-logs",
     "max_age_days": 30
    },
    {
     "path": "/var/www/*/wp-content/uploads/wc-logs",
     "max_age_days": 30
    },
    {
     "path": "/var/www/*/public_html/wp-content/uploads/wc-logs",
     "max_age_days": 30
    },
    {
     "path": "/var/www/*/htdocs/wp-content/uploads/wc-logs",
     "max_age_days": 30
    },
    {
     "path": "/srv/www/*/wp-content/uploads/wc-logs",
     "max_age_days": 30
    },
    {
     "path": "/var/www/vhosts/*/httpdocs/wp-content/uploads/wc-logs",
     "max_age_days": 30
    },
    {
     "path": "/www/wwwroot/*/wp-content/uploads/wc-logs",
     "max_age_days": 30
    }
   ],
   "backups": [
    "/var/www/html/wp-content/updraft",
    "/var/www/*/wp-content/updraft",
    "/var/www/*/public_html/wp-content/updraft",
    "/var/www/*/htdocs/wp-content/updraft",
    "/srv/www/*/wp-content/updraft",
    "/var/www/vhosts/*/httpdocs/wp-content/updraft",
    "/www/wwwroot/*/wp-content/updraft",
    "/var/www/html/wp-content/ai1wm-backups",
    "/var/www/*/wp-content/ai1wm-backups",
    "/var/www/*/public_html/wp-content/ai1wm-backups",
    "/var/www/*/htdocs/wp-content/ai1wm-backups",
    "/srv/www/*/wp-content/ai1wm-backups",
    "/var/www/vhosts/*/httpdocs/wp-content/ai1wm-backups",
    "/www/wwwroot/*/wp-content/ai1wm-backups",
    "/var/www/html/wp-content/backups*",
    "/var/www/*/wp-content/backups*",
    "/var/www/*/public_html/wp-content/backups*",
    "/var/www/*/htdocs/wp-content/backups*",
    "/srv/www/*/wp-content/backups*",
    "/var/www/vhosts/*/httpdocs/wp-content/backups*",
    "/www/wwwroot/*/wp-content/backups*"
   ],
   "cleanup": [
    {
     "name": "WordPress: прострочені transient-записи",
     "bin": "wp",
     "foreach": [
      "/var/www/html/wp-config.php",
      "/var/www/*/wp-config.php",
      "/var/www/*/public_html/wp-config.php",
      "/var/www/*/htdocs/wp-config.php",
      "/srv/www/*/wp-config.php",
      "/var/www/vhosts/*/httpdocs/wp-config.php",
      "/www/wwwroot/*/wp-config.php"
     ],
     "cmd": [
      "wp",
      "transient",
      "delete",
      "--expired",
      "--allow-root",
      "--path={dir}"
     ]
    }
   ],
   "container_data": true,
   "advice": "Найчастіше ростуть wp-content/uploads (медіа), бекапи плагінів усередині wp-content і таблиці БД (wp_options, для WooCommerce - wp_actionscheduler_*, сесії). wp-content/debug.log вмикається WP_DEBUG_LOG - вимкни, якщо не потрібен."
  },
  {
   "id": "nextcloud",
   "name": "Nextcloud",
   "images": [
    "NextCloud"
   ],
   "detect": {
    "paths": [
     "/var/www/nextcloud/occ",
     "/var/www/html/occ",
     "/var/www/*/occ",
     "/var/snap/nextcloud"
    ],
    "containers": [
     "(^|/)nextcloud(:|$)",
     "nextcloud/all-in-one",
     "nextcloud/aio-nextcloud"
    ]
   },
   "data": [
    "/var/www/nextcloud/data",
    "/var/www/html/data",
    "/var/www/*/data",
    "/var/snap/nextcloud/common/nextcloud/data",
    "/mnt/ncdata",
    "/var/lib/docker/volumes/nextcloud_aio_nextcloud_data",
    "/var/lib/docker/volumes/nextcloud_aio_database",
    "/var/lib/mysql",
    "/var/lib/postgresql"
   ],
   "logs": [
    "/var/www/nextcloud/data/*.log",
    "/var/www/html/data/*.log",
    "/var/www/*/data/*.log",
    "/var/snap/nextcloud/common/nextcloud/data/*.log",
    "/mnt/ncdata/*.log",
    "/var/lib/docker/volumes/*nextcloud*/_data/data/*.log",
    "/var/lib/docker/volumes/nextcloud_aio_nextcloud_data/_data/*.log"
   ],
   "caches": [],
   "backups": [],
   "cleanup": [
    {
     "name": "Nextcloud occ trashbin:expire (за політикою зберігання самого Nextcloud)",
     "container": "(^|/)nextcloud(:|$)|aio-nextcloud",
     "cmd": [
      "docker",
      "exec",
      "-u",
      "www-data",
      "{c}",
      "php",
      "occ",
      "trashbin:expire"
     ]
    },
    {
     "name": "Nextcloud occ trashbin:expire (за політикою зберігання самого Nextcloud)",
     "foreach": [
      "/var/www/nextcloud/occ",
      "/var/www/html/occ",
      "/var/www/*/occ"
     ],
     "as_owner": true,
     "cmd": [
      "php",
      "{p}",
      "trashbin:expire"
     ]
    },
    {
     "name": "Nextcloud occ trashbin:expire (за політикою зберігання самого Nextcloud)",
     "bin": "nextcloud.occ",
     "cmd": [
      "nextcloud.occ",
      "trashbin:expire"
     ]
    },
    {
     "name": "Nextcloud occ versions:expire (за політикою зберігання самого Nextcloud)",
     "container": "(^|/)nextcloud(:|$)|aio-nextcloud",
     "cmd": [
      "docker",
      "exec",
      "-u",
      "www-data",
      "{c}",
      "php",
      "occ",
      "versions:expire"
     ]
    },
    {
     "name": "Nextcloud occ versions:expire (за політикою зберігання самого Nextcloud)",
     "foreach": [
      "/var/www/nextcloud/occ",
      "/var/www/html/occ",
      "/var/www/*/occ"
     ],
     "as_owner": true,
     "cmd": [
      "php",
      "{p}",
      "versions:expire"
     ]
    },
    {
     "name": "Nextcloud occ versions:expire (за політикою зберігання самого Nextcloud)",
     "bin": "nextcloud.occ",
     "cmd": [
      "nextcloud.occ",
      "versions:expire"
     ]
    }
   ],
   "container_data": true,
   "advice": "Ростуть файли користувачів, їхні версії та кошик, прев'ю (appdata_*/preview). Кошик і версії я підчищаю лише за правилами самого Nextcloud (trashbin_retention_obligation, versions_retention_obligation в config.php)."
  },
